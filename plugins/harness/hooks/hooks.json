{
  "modules": ["./register.tsx"],
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-shared-tree-git.py\"", "timeout": 10 }] },
      { "matcher": "Bash|Read|Edit|MultiEdit|Write|Grep",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-secret-files.py\"", "timeout": 10 }] }
    ]
  }
}
